{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/alert/**",
              "components/button/**",
              "components/descriptions/**",
              "components/icon/**",
              "components/innovation-curve/**",
              "components/input/**",
              "components/quick-amount-input/**",
              "components/table/**",
              "components/tag/**",
              "doc-page.js",
              "icons/**",
              "ui_kits/ndps-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Noto Serif|Noto Sans|Inter))/i]",
        "message": "Font not provided by the design system. Available: Noto Serif, Noto Sans, Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|title|description|style|key|ref|className|style|children)$/]",
        "message": "<Alert> doesn't accept that prop. Declared props: variant, title, description, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:info|success|warning|error)$/]",
        "message": "<Alert> variant must be one of 'info' | 'success' | 'warning' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|size|disabled|children|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: type, size, disabled, children, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:primary|default|neutral|text)$/]",
        "message": "<Button> type must be one of 'primary' | 'default' | 'neutral' | 'text'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:small|medium|large)$/]",
        "message": "<Button> size must be one of 'small' | 'medium' | 'large'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DescriptionsItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|full|key|ref|className|style|children)$/]",
        "message": "<DescriptionsItem> doesn't accept that prop. Declared props: label, value, full."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|title|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='InnovationCurve'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|color|gridOpacity|style|key|ref|className|style|children)$/]",
        "message": "<InnovationCurve> doesn't accept that prop. Declared props: variant, size, color, gridOpacity, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='InnovationCurve'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:wireframe|solid)$/]",
        "message": "<InnovationCurve> variant must be one of 'wireframe' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|placeholder|helper|state|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, value, placeholder, helper, state, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:default|focus|error|disabled)$/]",
        "message": "<Input> state must be one of 'default' | 'focus' | 'error' | 'disabled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuickAmountInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|presets|selectedIndex|onSelectPreset|error|style|key|ref|className|style|children)$/]",
        "message": "<QuickAmountInput> doesn't accept that prop. Declared props: label, value, presets, selectedIndex, onSelectPreset, error, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TableColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|title|align|amount|action|render|key|ref|className|style|children)$/]",
        "message": "<TableColumn> doesn't accept that prop. Declared props: key, title, align, amount, action, render."
      },
      {
        "selector": "JSXOpeningElement[name.name='TableColumn'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<TableColumn> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|children|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: variant, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|success|warning|error|neutral)$/]",
        "message": "<Tag> variant must be one of 'primary' | 'success' | 'warning' | 'error' | 'neutral'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
